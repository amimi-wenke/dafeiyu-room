{
  "name": "dafeiyu-room",
  "version": "0.3.6",
  "private": true,
  "description": "大肥鱼的桌面小屋（Electron），配合 DSH 插件 dsh-room-world 使用",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "test": "node --test connector/server.test.mjs tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.dafeiyu.room",
    "productName": "大肥鱼的小屋",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "connector/server.mjs",
      "index.html",
      "room.js",
      "room.css",
      "dsh-client.js",
      "dsh.css",
      "chat.html",
      "package.json",
      "assets/world/*.png",
      "assets/world/layout.json",
      "assets/world/world-manifest.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Dafeiyu-Room-${version}-portable.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "license": "SEE LICENSE IN LICENSE (code: MIT; assets: CC BY-NC-SA 4.0, see ASSETS.md)"
}
